#!/usr/bin/env bash
#
# Run this project's Gradle build on the .101 box instead of locally.
#
# The local machine has four cores and shares them with the editor and the browser; .101 has
# sixteen and sits idle. This wrapper makes `rgradlew <tasks...>` behave like `./gradlew
# <tasks...>` while the compiler and the tests actually run in an isolated container on .101.
#
# Why a wrapper and not Gradle's own remote cache or a distributed-test plugin: the build is
# small and the tasks people run are interactive (`test`, `assembleDebug`), which reschedule
# badly. The expensive part is the Kotlin compiler and the JVM test workers, and moving the
# whole build moves both at once without changing a line of build logic.
#
# Cost model, measured: an incremental `rsync` of the tree with no edits takes ~0.4s, and an
# up-to-date `:core:test` takes 6s there against 17s here. The sync is therefore cheap enough
# to do unconditionally before every invocation, which keeps the remote tree honest instead of
# relying on a daemon to notice edits.
#
# What is NOT synced: `.git` (the wrapper never touches history), the build outputs (they are
# regenerated), and the vendored toolchain/SDK (`profile.d` and the image own those).
#
# Usage:
#   rgradlew :core:test                    # as ./gradlew
#   rgradlew :app:assembleDebug
#   rgradlew --status                      # is the container up, and where does it run
#   rgradlew --stop                        # stop the container
#   rgradlew --pull-apk [path]             # copy the debug APK back
#
# Environment: DSH_CI_HOST (default gwang@192.168.111.101), DSH_CI_KEY, DSH_CI_DIR,
# DSH_CI_CONTAINER, DSH_CI_MEMORY, DSH_CI_CPUS.
set -euo pipefail

HOST="${DSH_CI_HOST:-gwang@192.168.111.101}"
KEY="${DSH_CI_KEY:-/home/gwang/.dsh/keystore/n8n_101}"
DIR="${DSH_CI_DIR:-/datastore/android-ci}"
CONTAINER="${DSH_CI_CONTAINER:-dsh-ci}"
IMAGE="dsh-android-ci:latest"
MEMORY="${DSH_CI_MEMORY:-6g}"
CPUS="${DSH_CI_CPUS:-12}"
# `unless-stopped` rather than `always`: the container comes back after a reboot of the .101
# host, but a deliberate `rgradlew --stop` still keeps it down. It also matches what the other
# containers on that box use.
RESTART="${DSH_CI_RESTART:-unless-stopped}"
# Heap sizes for the two JVMs a Gradle build starts.
#
# The repo sets `org.gradle.jvmargs=-Xmx4g`, and the Kotlin daemon inherits that value unless
# `kotlin.daemon.jvmargs` says otherwise — so one build starts *two* JVMs that may each take
# 4 GB of heap. Measured inside the container: Gradle daemon 2.6 GB resident, Kotlin daemon
# 2.4 GB, peak 5.07 GB against a 6 GB limit. That is one unlucky build away from an OOM kill,
# and the .101 host shares its memory with the inference boxes (b70-sycl alone holds 10.7 GB),
# so the cap is lowered here rather than the container limit raised there.
GRADLE_HEAP="${DSH_CI_GRADLE_HEAP:-2g}"
KOTLIN_HEAP="${DSH_CI_KOTLIN_HEAP:-1500m}"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# -F /dev/null keeps the sandbox's unreadable system ssh_config out of the picture; the
# known_hosts file is not writable here, so it is pointed at /dev/null as well.
SSH=(ssh -F /dev/null -o BatchMode=yes -o ConnectTimeout=10 \
     -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -i "$KEY")
remote() { "${SSH[@]}" "$HOST" "$@"; }

container_running() {
    remote "docker inspect -f '{{.State.Running}}' $CONTAINER 2>/dev/null" 2>/dev/null | grep -q true
}

ensure_container() {
    if container_running; then
        return
    fi
    if ! remote "docker image inspect $IMAGE >/dev/null 2>&1"; then
        echo "rgradlew: image $IMAGE is missing on $HOST" >&2
        echo "rgradlew: rebuild it with: rsync scripts/ci-Dockerfile $HOST:$DIR/Dockerfile && docker build -t $IMAGE $DIR" >&2
        exit 2
    fi
    # A container that exists but is not running is the normal state after the host reboots,
    # and `docker run --name` refuses a name that is already taken — so the existing one is
    # started and re-configured instead of being recreated. Recreating it would also throw away
    # the Gradle and Kotlin daemons, which is most of the win for the incremental case.
    if remote "docker container inspect $CONTAINER >/dev/null 2>&1"; then
        # `docker update` also re-applies the limits, so a container created by an older version
        # of this script picks up a changed MEMORY/CPUS instead of keeping the old ones.
        remote "docker update --restart $RESTART --memory $MEMORY --cpus $CPUS $CONTAINER >/dev/null"
        remote "docker start $CONTAINER >/dev/null"
    else
        # The container idles so the Gradle daemon and the Kotlin daemon survive between
        # invocations; recreating it per build would pay the daemon start-up every time, which is
        # most of the win for the incremental case.
        #
        # The restart policy is what keeps it alive across a reboot of the .101 host. Without it
        # the container is created with the default `no`, and the next reboot leaves the build
        # box down until someone notices — which is exactly what happened on 2026-10-20.
        remote "docker run -d --name $CONTAINER --restart $RESTART --memory=$MEMORY --cpus=$CPUS \
            -v $DIR/workspace:/workspace -v $DIR/gradle-home:/opt/gradle-home \
            -w /workspace $IMAGE sleep infinity >/dev/null"
    fi
    # A fresh container has an empty /opt/gradle-home only if the bind mount is new; the mount
    # is persistent, so a warm cache is the normal case.
}

# Keep the JVM heaps inside what the container can hold.
#
# The override lives in `GRADLE_USER_HOME/gradle.properties`, which outranks the project's own
# `gradle.properties` — so the repository keeps the -Xmx4g it wants for local builds, and only
# the remote build box is constrained. Nothing is installed on the host to make that happen;
# the file is inside the bind mount the container already uses.
apply_memory_limits() {
    local target="$DIR/gradle-home/gradle.properties"
    local want
    want="$(printf 'org.gradle.jvmargs=-Xmx%s -Dfile.encoding=UTF-8 -XX:+UseParallelGC\nkotlin.daemon.jvmargs=-Xmx%s\n' \
        "$GRADLE_HEAP" "$KOTLIN_HEAP")"
    local have
    have="$(remote "cat $target 2>/dev/null || true")"
    if [[ "$have" == "$want" ]]; then
        return
    fi
    # A daemon started with different jvmargs is not reused: Gradle would start a *second* one
    # beside the old, and the old lingers for its three-hour idle timeout — two daemons where
    # there should be one, which is the very thing the heap cap is meant to prevent. Stopping
    # them first keeps exactly one alive.
    remote "docker exec $CONTAINER ./gradlew --stop >/dev/null 2>&1 || true"
    # The content goes over stdin rather than inside the command string: a heredoc nested in an
    # ssh command does not survive the hop.
    printf '%s' "$want" | remote "cat > $target"
}

# Local paths, and the exclusions that keep the transfer to source only.
sync_to_remote() {
    local -a excludes=(
        --exclude='.git/' --exclude='build/' --exclude='*/build/'
        --exclude='.gradle/' --exclude='.sdk/' --exclude='.toolchain/'
        --exclude='.gradle-home/' --exclude='apk/' --exclude='.tmp/'
        --exclude='.audit/' --exclude='*.apk' --exclude='.idea/'
    )
    rsync -az --delete "${excludes[@]}" \
        -e "ssh -F /dev/null -o BatchMode=yes -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -i $KEY" \
        "$REPO_ROOT/" "$HOST:$DIR/workspace/" >/dev/null
    # The remote SDK lives inside the image, so the checked-out `local.properties` (which names
    # the local one) must not travel. Written every sync because rsync --delete would otherwise
    # remove it as a local-to-remote deletion.
    remote "printf 'sdk.dir=/opt/android-sdk\n' > $DIR/workspace/local.properties"
}

usage() { sed -n '3,32p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    --status)
        if container_running; then
            echo "rgradlew: container $CONTAINER is running on $HOST"
            remote "docker exec $CONTAINER ./gradlew --version 2>/dev/null | grep -E 'Gradle|JVM' | head -2"
        else
            echo "rgradlew: container $CONTAINER is not running on $HOST"
        fi
        exit 0
        ;;
    --stop)
        remote "docker stop $CONTAINER >/dev/null 2>&1 || true"
        echo "rgradlew: stopped $CONTAINER"
        exit 0
        ;;
    --pull-apk)
        dest="${2:-$REPO_ROOT/app/build/outputs/apk/debug/app-debug.apk}"
        remote "cat $DIR/workspace/app/build/outputs/apk/debug/app-debug.apk" > "$dest"
        echo "rgradlew: wrote $dest"
        exit 0
        ;;
esac

if [[ $# -eq 0 ]]; then
    usage
    exit 2
fi

ensure_container
apply_memory_limits
sync_to_remote

# Each argument is quoted before it crosses the ssh hop. `ssh host "cmd $*"` would split on
# whitespace and re-expand remotely, so a task name or a `-Pfoo=bar baz` property would arrive
# mangled; building the remote command from `printf %q` keeps the argument vector intact.
remote_cmd="docker exec -i $CONTAINER ./gradlew"
for arg in "$@"; do
    remote_cmd+=" $(printf '%q' "$arg")"
done

# `--console=plain` is added only when the caller did not pick a console mode. Gradle rejects a
# repeated `--console` outright ("Multiple arguments were provided"), and release.sh passes it
# for every step it runs — so appending unconditionally made `RGRADLEW=1 release.sh` fail before
# the first task ran.
has_console=0
for arg in "$@"; do
    case "$arg" in --console|--console=*) has_console=1 ;; esac
done
if [[ $has_console -eq 0 ]]; then
    remote_cmd+=" --console=plain"
fi

# The exit status is Gradle's, so callers can branch on it exactly as they do locally.
exec "${SSH[@]}" "$HOST" "$remote_cmd"
